        <interface>
          <outputVars>
            <variable name="inlet_valve_open">
              <type><BOOL /></type>
              <initialValue><simpleValue value="FALSE" /></initialValue>
            </variable>
          </outputVars>
          <localVars>
            <variable name="reported_level_pct"><type><REAL /></type></variable>
            <variable name="LOW_LEVEL_PCT">
