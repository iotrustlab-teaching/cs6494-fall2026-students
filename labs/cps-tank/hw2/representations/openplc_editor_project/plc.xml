        </interface>
        <body>
          <ST>
            <xhtml:p>IF reported_level_pct &lt; LOW_LEVEL_PCT THEN
    inlet_valve_open := TRUE;
ELSIF reported_level_pct &gt; HIGH_LEVEL_PCT THEN
    inlet_valve_open := FALSE;
END_IF;</xhtml:p>
          </ST>
        </body>
